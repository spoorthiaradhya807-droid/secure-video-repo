SECRET_KEY=change-me-to-a-long-random-string
AWS_REGION=ap-south-1
S3_BUCKET=your-bucket-name
INSTRUCTOR_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/VideoRepo-InstructorRole
VIEWER_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/VideoRepo-ViewerRole
PRESIGN_SECONDS=300

# Upload limits: files go to S3 in chunks, so size is only limited by this setting (S3 max is 5 TB)
MAX_UPLOAD_GB=10
PART_SIZE_MB=8

# Forgot-password e-mail via Amazon SES. Leave SES_SENDER empty = dev mode (link printed in the terminal)
SES_SENDER=
SES_REGION=ap-south-1
# Public address of the site, used inside reset e-mails (set it on EC2, e.g. https://ec2-xx.compute.amazonaws.com)
APP_BASE_URL=

# On EC2 behind nginx/HTTPS set both to 1
BEHIND_PROXY=0
COOKIE_SECURE=0
